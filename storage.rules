rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isVerifiedOwner() {
      return signedIn()
        && request.auth.token.email == 'imran1914771651@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public ad assets: everyone can view; only verified owner can manage.
    match /publicAds/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedOwner()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isVerifiedOwner();
    }

    // No other Storage paths are accessible until explicitly authorized.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
